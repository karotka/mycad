{
  "name": "mycad",
  "productName": "MyCAD",
  "version": "1.0.0",
  "description": "AutoCAD-style 2D/3D CAD for macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder --mac",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.mycad.app",
    "executableName": "MyCAD",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "pdfjs-dist": "^6.3.289",
    "three": "^0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.1",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
